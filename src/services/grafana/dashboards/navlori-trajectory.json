    {
      "title": "Robot Trajectory (XY)",
      "description": "Real-time ground truth position plotted as X vs Y. Red safety zones and wall geometry are approximated by the waypoint constraints.",
      "type": "xychart",
      "id": 1,
      "gridPos": { "h": 20, "w": 16, "x": 0, "y": 1 },
      "datasource": { "type": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "gt_x" },
            "properties": [
              { "id": "displayName", "value": "X (m)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "gt_y" },
            "properties": [
              { "id": "displayName", "value": "Y (m)" }
            ]
          }
        ]
      },
      "options": {
        "seriesMapping": "manual",
        "dims": {
          "x": "gt_x",
          "y": ["gt_y"]
        },
        "series": [
          {
            "x": "gt_x",
            "y": "gt_y",
            "name": "Trajectory",
            "color": { "mode": "fixed", "fixedColor": "#2196F3" },
            "lineWidth": 2,
            "lineStyle": { "fill": "solid" },
            "pointSize": { "fixed": 4 },
            "show": "lines+points"
          }
        ],
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"async_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ground_truth\")\n  |> filter(fn: (r) => r._field == \"gt_x\" or r._field == \"gt_y\")\n  |> filter(fn: (r) => r.path_id == \"${path_id}\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ]
    },
