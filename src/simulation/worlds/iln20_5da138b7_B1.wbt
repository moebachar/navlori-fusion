# To hide the ceiling at runtime, right-click DEF CEILING in the
# Webots scene tree and choose Hide -- or edit appearance.transparency
# below to 1.0 for a permanent hide.
DEF CEILING Group {
  children [
    Solid {
      translation 142.3329 218.8603 3.2500
      name "ceiling_slab"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.92 0.92 0.90
            roughness 0.85
            metalness 0.0
            transparency 0.0
          }
          geometry Box { size 286.2615 438.9260 0.1000 }
        }
      ]
    }
  ]
}

