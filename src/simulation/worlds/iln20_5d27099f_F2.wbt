# To hide the ceiling at runtime, right-click DEF CEILING in the
# Webots scene tree and choose Hide -- or edit appearance.transparency
# below to 1.0 for a permanent hide.
DEF CEILING Group {
  children [
    Solid {
      translation 23.8949 67.8492 3.2500
      name "ceiling_slab"
