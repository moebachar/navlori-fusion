# NavLoRI-Fusion — environment variables (copy to .env, do not commit).
#
# .env is loaded by scripts/services.ps1 before starting InfluxDB / Grafana
# and is consumed by every Webots controller that writes to InfluxDB.

# ─── InfluxDB ───────────────────────────────────────────────────────────────
# Generate a fresh token with `influx auth create` (or via the InfluxDB UI)
# after running scripts/setup_influxdb.ps1.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-me-with-a-fresh-token
INFLUXDB_ORG=navlori
INFLUXDB_BUCKET=async_data
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=replace-me-with-a-strong-password

# ─── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
