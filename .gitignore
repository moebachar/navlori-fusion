# ─── Secrets / local-only configs ───────────────────────────────────────────
.env
.env.local
.env.*.local
.mcp.json
src/simulation/controllers/*/runtime.ini
!src/simulation/controllers/*/runtime.ini.example

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# ─── Data ───────────────────────────────────────────────────────────────────
# Everything in data/ is local; reproducibility goes through DVC pointers
# (.dvc files) and the conversion scripts under scripts/convert_*.py.
data/*
!data/.gitkeep
!data/*.dvc

# ─── Training / experiment artifacts ────────────────────────────────────────
runs/
mlruns/
tb_logs/
notebooks/runs/
output/
logs/
*.log
*.pt
*.ckpt

# ─── External / vendored code (clone separately, see docs/EXTERNAL_DEPENDENCIES.md)
external/
downloads/

# ─── Scratch / WIP ──────────────────────────────────────────────────────────
scratch/
*.scratch.py

# ─── Local services (binaries + runtime state) ──────────────────────────────
src/services/influxdb/
src/services/grafana/bin/
src/services/grafana/data/
# A `services/` dir at the repo root is created by scripts/setup_services.ps1
# for local InfluxDB/Grafana binaries — entirely local, never commit.
/services/

# ─── DVC ────────────────────────────────────────────────────────────────────
/dvc_store/
/.dvc/cache/
/.dvc/tmp/

# ─── Vision encoder backbone cache (DINOv2 / ACE weights pulled at runtime) ─
.vit_cache/
.ace_cache/

# ─── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ─── Local agent state ──────────────────────────────────────────────────────
.claude/
CLAUDE.md
